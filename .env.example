# Local development configuration. Copy to `.env` and adjust as needed.
# Never commit `.env`. Never put real credentials or personal data in this file.

# --- Web application ---------------------------------------------------------
# Port the web service listens on, and the host port compose publishes.
WEB_PORT=3000

# --- Worker ------------------------------------------------------------------
# Port the background worker exposes its health endpoint on.
WORKER_PORT=3001

# --- Database ----------------------------------------------------------------
# Local Postgres credentials used by compose.
POSTGRES_PASSWORD=postgres
# `postgres` matches Supabase and is required by pg_cron (cron.database_name).
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# Application connection. Locally this is plain Postgres; in deployment it MUST be the
# Supavisor transaction-mode URL (port 6543) or serverless instances will exhaust
# Postgres connections. See ARCHITECTURE.md §3.4.
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# Direct connection (port 5432), used only by migrations, which need session-level
# features the transaction pooler does not support. Leave unset locally.
# DIRECT_URL=

# Sockets per instance. Keep small — many instances share one pooler.
DATABASE_MAX_CONNECTIONS=5

# Staging (Supabase project ref ymdxmhpfdurkfdbryfwr, ap-northeast-2) uses these shapes.
# Never commit real values; set them as GitHub Actions secrets.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
#   DIRECT_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Object storage (SeaweedFS locally, Supabase Storage / R2 in deployment) -
# Local-only development credentials; these are not secrets.
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_ACCESS_KEY=localdev
STORAGE_SECRET_KEY=localdev-secret
STORAGE_BUCKET=family-tree-media
STORAGE_PORT=8333
STORAGE_CONSOLE_PORT=9333

# --- Email (Mailpit locally; no mail leaves the machine) ---------------------
SMTP_URL=smtp://localhost:1025
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- Observability -----------------------------------------------------------
# Leave unset to disable telemetry entirely, which is the self-host default.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=family-tree
LOG_LEVEL=info
