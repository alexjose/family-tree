# Local development configuration. Copy to `.env` and adjust as needed.
# Never commit `.env`. Never put real credentials or personal data in this file.

# --- Web application ---------------------------------------------------------
# Port the web service listens on, and the host port compose publishes.
WEB_PORT=3000

# --- Worker ------------------------------------------------------------------
# Port the background worker exposes its health endpoint on.
WORKER_PORT=3001

# --- Database ----------------------------------------------------------------
# Local Postgres credentials used by compose. Production uses Supabase and the
# Supavisor pooler; see ARCHITECTURE.md §3.4.
POSTGRES_PASSWORD=postgres
# `postgres` matches Supabase and is required by pg_cron (cron.database_name).
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# Connection string used by the apps. Inside compose the host is `db`.
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres

# --- Object storage (SeaweedFS locally, Supabase Storage / R2 in deployment) -
# Local-only development credentials; these are not secrets.
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_ACCESS_KEY=localdev
STORAGE_SECRET_KEY=localdev-secret
STORAGE_BUCKET=family-tree-media
STORAGE_PORT=8333
STORAGE_CONSOLE_PORT=9333

# --- Email (Mailpit locally; no mail leaves the machine) ---------------------
SMTP_URL=smtp://localhost:1025
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# --- Observability -----------------------------------------------------------
# Leave unset to disable telemetry entirely, which is the self-host default.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=family-tree
LOG_LEVEL=info
